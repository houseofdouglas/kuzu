  { "from": "common.arrow-interop",  "to": "common.value-vector", "strength": "required" },
  { "from": "common.arrow-interop",  "to": "common.type-system",  "strength": "required" },

  // storage: buffer-manager depends on common type primitives (via types.h)
  { "from": "storage.buffer-manager",   "to": "common.type-system",    "strength": "required" },

  // storage: WAL depends on serializer and filesystem
