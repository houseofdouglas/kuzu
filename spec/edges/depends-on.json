[
  // ── Feature -> Feature (intra-subsystem) ────────────────────────────────

  // common: value-vector needs type-system and null-mask
  { "from": "common.value-vector",   "to": "common.type-system",  "strength": "required" },
  { "from": "common.value-vector",   "to": "common.null-mask",    "strength": "required" },

